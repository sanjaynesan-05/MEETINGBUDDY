PORT=5000
MONGO_URI=mongodb://localhost:27017/meeting_intelligence
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=uploads

# Whisper Configuration (local Python whisper)
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

#FFMPEG
FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meeting_chunks
QDRANT_ENABLED=true
QDRANT_TIMEOUT_MS=5000

# Transcription Configuration
TRANSCRIPTION_TIMEOUT_MS=600000
TRANSCRIPTION_STALL_TIMEOUT_MS=120000
TRANSCRIPTION_INITIAL_TIMEOUT_MS=120000

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# AI Generation
OLLAMA_MODEL=qwen2.5:7b

# Diarization (optional)
ENABLE_DIARIZATION=false
HF_TOKEN=your_huggingface_token

# SMTP / Email Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Calendar OAuth2 (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

# Outlook Calendar OAuth2 (optional)
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/outlook/callback
OUTLOOK_TENANT_ID=common
